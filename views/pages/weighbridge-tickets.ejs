<div class="space-y-5" dir="<%= dir %>">
<%- include('../partials/flash') %>
<% if(form){ const net=Math.abs((Number(form.first_weight_kg)||0)-(Number(form.second_weight_kg)||0)); %><div class="wb-panel rounded-[1.8rem] p-5 md:p-6"><div class="mb-5 flex justify-between border-b pb-5"><div><h3 class="font-black"><%= editingId?t('forms.weighbridge.edit'):t('forms.weighbridge.new') %></h3><p class="mt-1 text-xs text-slate-500"><%= t('forms.weighbridge.desc') %></p></div><a href="/weighbridge-tickets" class="rounded-2xl bg-slate-100 px-4 py-2 text-sm font-black"><%= t('common.closeForm') %></a></div><form method="POST" action="/weighbridge-tickets/save"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= editingId||'' %>"><div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
<div><label class="wb-label"><%= t('fields.ticketNo') %></label><input name="ticket_no" value="<%= form.ticket_no||'' %>" class="wb-input" required></div><div><label class="wb-label"><%= t('fields.customer') %></label><select name="customer_id" class="wb-input"><option value=""><%= t('fields.noCustomer') %></option><% for(const c of customers){ %><option value="<%= c.id %>" <%= String(form.customer_id||'')===String(c.id)?'selected':'' %>><%= c.customer_code %> - <%= c.name %></option><% } %></select></div><div><label class="wb-label"><%= t('fields.cargo') %></label><select name="cargo_item_id" class="wb-input"><option value=""><%= t('fields.noCargo') %></option><% for(const c of cargoItems){ %><option value="<%= c.id %>" <%= String(form.cargo_item_id||'')===String(c.id)?'selected':'' %>><%= c.cargo_code %> - <%= c.name %></option><% } %></select></div><div><label class="wb-label"><%= t('fields.weighType') %></label><select name="weigh_type" class="wb-input"><option value="loading" <%= form.weigh_type==='loading'?'selected':'' %>><%= fa('loading') %></option><option value="unloading" <%= form.weigh_type==='unloading'?'selected':'' %>><%= fa('unloading') %></option></select></div>
<div><label class="wb-label"><%= t('fields.plate') %></label><input name="vehicle_plate" value="<%= form.vehicle_plate||'' %>" class="wb-input"></div><div><label class="wb-label"><%= t('fields.driver') %></label><input name="driver_name" value="<%= form.driver_name||'' %>" class="wb-input"></div><div><label class="wb-label"><%= t('fields.driverPhone') %></label><input name="driver_phone" value="<%= form.driver_phone||'' %>" class="wb-input"></div><div><label class="wb-label"><%= t('fields.cartons') %></label><input name="carton_count" type="number" min="0" value="<%= form.carton_count??'' %>" class="wb-input"></div>
<div><label class="wb-label"><%= t('fields.weightFirst') %></label><input name="first_weight_kg" type="number" step="0.01" min="0" value="<%= form.first_weight_kg??'' %>" class="wb-input" required></div><div><label class="wb-label"><%= t('fields.weightSecond') %></label><input name="second_weight_kg" type="number" step="0.01" min="0" value="<%= form.second_weight_kg??'' %>" class="wb-input" required></div><div><label class="wb-label"><%= t('fields.weightAuto') %></label><div class="wb-input flex items-center bg-teal-50 font-black text-teal-700"><%= faWeight(net) %></div></div><div class="xl:col-span-4"><label class="wb-label"><%= t('fields.notes') %></label><textarea name="notes" rows="3" class="wb-input !h-auto py-3"><%= form.notes||'' %></textarea></div></div><div class="mt-5 flex justify-end gap-3"><a href="/weighbridge-tickets" class="h-11 inline-flex items-center rounded-2xl bg-slate-100 px-5 text-sm font-black"><%= t('common.cancel') %></a><button class="h-11 rounded-2xl bg-teal-600 px-6 text-sm font-black text-white"><%= t('common.save') %></button></div></form></div><% } %>
<div class="wb-card overflow-hidden rounded-[1.8rem]"><%- include('../partials/table-toolbar', { search, buttons: [{ href: '/weighbridge-tickets?form=create', label: t('pages.weighbridge.add'), icon: 'plus', variant: 'primary' }] }) %><div class="overflow-x-auto"><table class="min-w-full text-right text-sm"><thead><tr class="border-b bg-slate-50 text-xs text-slate-500"><th class="px-5 py-4"><%= t('common.row') %></th><th class="px-5 py-4"><%= t('fields.ticket') %></th><th class="px-5 py-4"><%= t('fields.customer') %></th><th class="px-5 py-4"><%= t('fields.cargo') %></th><th class="px-5 py-4"><%= t('fields.vehicleDriver') %></th><th class="px-5 py-4"><%= t('reportCols.weightFirst') %></th><th class="px-5 py-4"><%= t('reportCols.weightSecond') %></th><th class="px-5 py-4"><%= t('reportCols.netWeight') %></th><th class="px-5 py-4"><%= t('common.actions') %></th></tr></thead><tbody class="divide-y"><% if(!rows.length){ %><tr><td colspan="9" class="py-12 text-center text-slate-500"><%= t('pages.weighbridge.empty') %></td></tr><% } %><% rows.forEach((r, i) => { %><tr class="hover:bg-teal-50/50"><td class="px-5 py-4 font-black text-slate-500"><%= rowNo(pagination, i) %></td><td class="px-5 py-4 font-black"><%= r.ticket_no %></td><td class="px-5 py-4"><%= r.customer_name||'-' %></td><td class="px-5 py-4"><%= r.cargo_name||'-' %></td><td class="px-5 py-4"><%= r.vehicle_plate||'-' %><div class="text-xs text-slate-500"><%= r.driver_name||'' %></div></td><td class="px-5 py-4"><%= faWeight(r.first_weight_kg) %></td><td class="px-5 py-4"><%= faWeight(r.second_weight_kg) %></td><td class="px-5 py-4 font-black text-teal-700"><%= faWeight(r.net_weight_kg) %></td><td class="px-5 py-4"><div class="flex gap-2"><a href="/weighbridge-tickets?edit=<%= r.id %>" class="rounded-2xl bg-slate-100 px-3 py-2 text-xs font-black"><%= t('common.edit') %></a><form method="POST" action="/weighbridge-tickets/<%= r.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button data-confirm="<%= t('fields.confirmDeleteTicket') %>" class="rounded-2xl bg-red-50 px-3 py-2 text-xs font-black text-red-600"><%= t('common.delete') %></button></form></div></td></tr><% }) %></tbody></table></div><div class="border-t px-5 py-4"><%- include('../partials/pagination') %></div></div>
</div>
