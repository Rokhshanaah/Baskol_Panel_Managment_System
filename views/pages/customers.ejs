<div class="space-y-5" dir="<%= dir %>">
<%- include('../partials/flash') %>
<% if (form) { %>
<div class="customer-panel rounded-[1.8rem] p-5 md:p-6"><div class="mb-5 flex flex-col gap-3 border-b border-slate-200 pb-5 md:flex-row md:items-center md:justify-between"><div class="flex items-center gap-3"><div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-50 text-teal-700"><%- icon('customer','h-7 w-7') %></div><div><h3 class="text-base font-black text-slate-900"><%= editingId ? t('forms.customers.edit') : t('forms.customers.new') %></h3><p class="mt-1 text-xs text-slate-500"><%= t('forms.customers.desc') %></p></div></div><a href="/customers" class="inline-flex h-10 items-center justify-center rounded-2xl bg-slate-100 px-4 text-sm font-black text-slate-700 hover:bg-red-500 hover:text-white"><%= t('common.closeForm') %></a></div>
<form method="POST" action="/customers/save" enctype="multipart/form-data" class="space-y-5"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= editingId || '' %>"><input type="hidden" name="customer_code" value="<%= form.customer_code || '' %>"><div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
<div><label class="customer-label"><%= t('fields.customerCode') %></label><div class="flex h-11 items-center justify-between rounded-2xl border border-teal-200 bg-teal-50 px-3"><span class="customer-value text-sm font-black text-teal-700"><%= form.customer_code || t('fields.auto') %></span><span class="rounded-full bg-white px-2 py-1 text-[11px] font-black text-teal-700"><%= t('fields.auto') %></span></div></div>
<div><label class="customer-label"><%= t('fields.customerName') %></label><input name="name" value="<%= form.name || '' %>" class="customer-input" required></div><div><label class="customer-label"><%= t('fields.fatherName') %></label><input name="father_name" value="<%= form.father_name || '' %>" class="customer-input"></div><div><label class="customer-label"><%= t('fields.phone') %></label><input name="phone" value="<%= form.phone || '' %>" class="customer-input"></div><div><label class="customer-label"><%= t('fields.email') %></label><input name="email" type="email" value="<%= form.email || '' %>" class="customer-input"></div><div><label class="customer-label"><%= t('fields.passport') %></label><input name="tazkira_or_passport" value="<%= form.tazkira_or_passport || '' %>" class="customer-input"></div><div class="md:col-span-2"><label class="customer-label"><%= t('fields.company') %></label><input name="company_name" value="<%= form.company_name || '' %>" class="customer-input"></div><div class="md:col-span-2"><label class="customer-label"><%= t('fields.address') %></label><input name="address" value="<%= form.address || '' %>" class="customer-input"></div><div class="md:col-span-2"><label class="customer-label"><%= t('fields.notes') %></label><textarea name="notes" rows="3" class="customer-input !h-auto py-3"><%= form.notes || '' %></textarea></div><div class="md:col-span-2 xl:col-span-4"><label class="customer-label"><%= t('fields.photo') %> <span class="text-xs font-normal text-slate-500">(<%= t('fields.optional') %>)</span></label><% if (form.photo_path) { %><div class="mb-2"><%- include('../partials/avatar', { photoPath: form.photo_path, name: form.name, fallback: t('fields.customer'), wrapClass: 'profile-avatar-preview' }) %></div><% } %><input type="file" name="photo" accept="image/*" class="customer-input !py-2 file:mr-3 file:rounded-xl file:border-0 file:bg-teal-50 file:px-3 file:py-1.5 file:text-sm file:font-black file:text-teal-700"><p class="mt-1 text-xs text-slate-500"><%= t('fields.photoHint') %></p></div></div><div class="flex justify-end gap-3"><a href="/customers" class="h-11 inline-flex items-center rounded-2xl bg-slate-100 px-5 text-sm font-black text-slate-700"><%= t('common.cancel') %></a><button class="h-11 rounded-2xl bg-teal-600 px-6 text-sm font-black text-white"><%= t('common.save') %></button></div></form></div>
<% } %>
<div class="customer-card overflow-hidden rounded-[1.8rem]"><%- include('../partials/table-toolbar', { search, buttons: [{ href: '/customers?form=create', label: t('pages.customers.add'), icon: 'plus', variant: 'primary' }] }) %>
<div class="overflow-x-auto"><table class="min-w-full text-right text-sm"><thead><tr class="border-b border-slate-200 bg-slate-50/80 text-xs text-slate-500"><th class="px-5 py-4"><%= t('common.row') %></th><th class="px-5 py-4"><%= t('fields.code') %></th><th class="px-5 py-4"><%= t('fields.customerName') %></th><th class="px-5 py-4"><%= t('fields.fatherName') %></th><th class="px-5 py-4"><%= t('fields.contact') %></th><th class="px-5 py-4"><%= t('fields.company') %></th><th class="px-5 py-4"><%= t('fields.passport') %></th><th class="px-5 py-4"><%= t('common.actions') %></th></tr></thead><tbody class="divide-y divide-slate-200/80 bg-white/55">
<% if (!rows.length) { %><tr><td colspan="8" class="px-5 py-12 text-center text-slate-500"><%= t('pages.customers.empty') %></td></tr><% } %>
<% rows.forEach((row, i) => { %><tr class="customer-table-row"><td class="px-5 py-4 font-black text-slate-500"><%= rowNo(pagination, i) %></td><td class="px-5 py-4 font-black"><%= row.customer_code || '-' %></td><td class="px-5 py-4 font-black"><%= row.name || '-' %></td><td class="px-5 py-4"><%= row.father_name || '-' %></td><td class="px-5 py-4"><%= row.phone || '-' %></td><td class="px-5 py-4"><%= row.company_name || '-' %></td><td class="px-5 py-4"><%= row.tazkira_or_passport || '-' %></td><td class="px-5 py-4"><div class="flex gap-2"><a href="/customers?edit=<%= row.id %>" class="inline-flex items-center gap-1 rounded-2xl bg-slate-100 px-3 py-2 text-xs font-black text-slate-700 hover:bg-teal-600 hover:text-white"><%- icon('edit','h-4 w-4') %><%= t('common.edit') %></a><form method="POST" action="/customers/<%= row.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button data-confirm="<%= t('fields.confirmDeleteCustomer') %>" class="inline-flex items-center gap-1 rounded-2xl bg-red-50 px-3 py-2 text-xs font-black text-red-600 hover:bg-red-500 hover:text-white"><%- icon('trash','h-4 w-4') %><%= t('common.delete') %></button></form></div></td></tr><% }) %>
</tbody></table></div><div class="border-t border-slate-200 px-5 py-4"><%- include('../partials/pagination') %></div></div>
</div>
