<div class="space-y-5 printable-area" dir="<%= dir %>">
<%- include('../partials/flash') %>

<% if (form) { %>
<div class="customer-panel rounded-[1.8rem] p-5 md:p-6">
  <h3 class="text-base font-black"><%= editingId ? t('forms.vehicleTrips.edit') : t('forms.vehicleTrips.new') %></h3>
  <p class="mt-1 mb-4 text-sm opacity-70"><%= t('forms.vehicleTrips.desc') %></p>
  <form method="POST" action="/vehicle-trips/save" class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="id" value="<%= editingId || '' %>">
    <input type="hidden" name="trip_no" value="<%= form.trip_no || '' %>">
    <div><label class="customer-label"><%= t('fields.vehicle') %></label><select name="vehicle_id" class="customer-input" required><option value=""><%= t('fields.select') %></option><% vehicles.forEach(v => { %><option value="<%= v.id %>" <%= String(form.vehicle_id)===String(v.id)?'selected':'' %>><%= v.plate_no %> (<%= v.vehicle_code %>)</option><% }) %></select></div>
    <div><label class="customer-label"><%= t('fields.origin') %></label><input name="origin" value="<%= form.origin || '' %>" class="customer-input"></div>
    <div><label class="customer-label"><%= t('fields.destination') %></label><input name="destination" value="<%= form.destination || '' %>" class="customer-input"></div>
    <div><label class="customer-label"><%= t('fields.driver') %></label><input name="driver_name" value="<%= form.driver_name || '' %>" class="customer-input"></div>
    <div><label class="customer-label"><%= t('fields.driverPhone') %></label><input name="driver_phone" value="<%= form.driver_phone || '' %>" class="customer-input"></div>
    <div class="md:col-span-2 xl:col-span-3 rounded-2xl border border-teal-200 bg-teal-50/80 px-4 py-3 text-sm text-teal-900 dark:border-teal-500/30 dark:bg-teal-500/10 dark:text-teal-100"><%= t('fields.tripFreightHint') %></div>
    <div class="md:col-span-2 xl:col-span-3 flex justify-end gap-3"><a href="/vehicle-trips<%= selectedTrip ? '?trip='+selectedTrip.id : '' %>" class="h-11 inline-flex items-center rounded-2xl bg-slate-100 px-5 text-sm font-black"><%= t('common.cancel') %></a><button class="h-11 rounded-2xl bg-teal-600 px-6 text-sm font-black text-white"><%= t('common.save') %></button></div>
  </form>
</div>
<% } %>

<% if (selectedTrip) { %>
<div class="grid grid-cols-1 gap-5 xl:grid-cols-3">
  <div class="page-panel rounded-[1.8rem] p-5 xl:col-span-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-xs font-black uppercase tracking-wide text-teal-700"><%= t('fields.trip') %></p>
        <h3 class="text-lg font-black"><%= selectedTrip.trip_no %> — <%= selectedTrip.plate_no %></h3>
        <p class="text-sm opacity-70"><%= selectedTrip.origin || '-' %> → <%= selectedTrip.destination || '-' %></p>
      </div>
      <div class="flex gap-2">
        <a href="/vehicle-trips?edit=<%= selectedTrip.id %>" class="rounded-2xl bg-slate-100 px-4 py-2 text-xs font-black"><%= t('common.edit') %></a>
        <a href="/deliveries?form=create&trip=<%= selectedTrip.id %>" class="rounded-2xl bg-teal-600 px-4 py-2 text-xs font-black text-white"><%= t('pages.deliveries.add') %></a>
      </div>
    </div>
    <% if (tripPl) { %>
    <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-3">
      <div class="rounded-2xl bg-emerald-50 p-4 dark:bg-emerald-500/10"><p class="text-xs font-black text-emerald-700"><%= t('fields.totalFreight') %></p><p class="text-xl font-black text-emerald-900"><%= formatMoney(tripPl.income, defaultCurrency) %></p></div>
      <div class="rounded-2xl bg-red-50 p-4 dark:bg-red-500/10"><p class="text-xs font-black text-red-700"><%= t('fields.tripExpenses') %></p><p class="text-xl font-black text-red-900"><%= formatMoney(tripPl.expenses, defaultCurrency) %></p></div>
      <div class="rounded-2xl p-4 <%= tripPl.profit >= 0 ? 'bg-blue-50 dark:bg-blue-500/10' : 'bg-orange-50 dark:bg-orange-500/10' %>"><p class="text-xs font-black"><%= tripPl.profit >= 0 ? t('dashboard.profit') : t('dashboard.loss') %></p><p class="text-xl font-black"><%= formatMoney(tripPl.profit, defaultCurrency) %></p></div>
    </div>
    <% } %>
  </div>

  <div class="page-panel rounded-[1.8rem] p-5 xl:col-span-2">
    <div class="mb-4 border-b border-[var(--app-border)] pb-4">
      <p class="text-xs font-black text-teal-700">۱</p>
      <h4 class="font-black"><%= t('fields.cargoAndFreight') %></h4>
      <p class="mt-1 text-xs opacity-70"><%= t('fields.cargoFreightDesc') %></p>
    </div>
    <form method="POST" action="/vehicle-trips/<%= selectedTrip.id %>/cargo" class="mb-5 rounded-2xl border bg-slate-50/80 p-4 dark:bg-slate-900/30">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-5">
        <div class="xl:col-span-2">
          <label class="customer-label"><%= t('fields.cargo') %></label>
          <select name="cargo_item_id" class="customer-input" required>
            <option value=""><%= t('fields.selectCargo') %></option>
            <% cargoItems.forEach(c => { %><option value="<%= c.id %>"><%= c.cargo_code %> — <%= c.name %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="customer-label"><%= t('fields.weight') %></label>
          <input name="weight_kg" type="number" step="0.01" min="0" class="customer-input" required>
        </div>
        <%- include('../partials/currency-fields', {
          prefix: 'tripCargoFreight',
          amount: '',
          currency: defaultCurrency,
          amountLabelKey: 'fields.freight',
          amountRequired: true,
          labelClass: 'customer-label',
          inputClass: 'customer-input',
        }) %>
        <div class="flex items-end">
          <button class="w-full rounded-2xl bg-teal-600 py-2.5 text-xs font-black text-white"><%= t('common.add') %></button>
        </div>
      </div>
    </form>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead><tr class="border-b text-xs opacity-60"><th class="py-2 text-right"><%= t('fields.cargo') %></th><th class="text-right"><%= t('fields.customer') %></th><th class="text-right"><%= t('fields.weight') %></th><th class="text-right"><%= t('fields.freight') %></th><th class="text-right"><%= t('fields.profit') %></th><th></th></tr></thead>
        <tbody>
          <% if (!cargoPl.length) { %>
            <tr><td colspan="6" class="py-8 text-center text-sm opacity-60"><%= t('fields.noCargoOnTrip') %></td></tr>
          <% } %>
          <% cargoPl.forEach((row) => { %>
            <tr class="border-t">
              <td class="py-2 font-bold"><%= row.cargo_name %></td>
              <td><%= row.customer_name || '-' %></td>
              <td><%= money(row.weight_kg) %></td>
              <td class="font-black text-emerald-700"><%= formatLegacyMoney(row, 'freight_usd', 'freight_currency') %></td>
              <td class="font-black <%= row.profit_usd >= 0 ? 'text-emerald-700' : 'text-red-700' %>"><%= formatMoney(row.profit_usd, defaultCurrency) %></td>
              <td>
                <form method="POST" action="/vehicle-trips/<%= selectedTrip.id %>/cargo/<%= row.id %>/delete">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="text-xs font-black text-red-600"><%= t('common.delete') %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="page-panel rounded-[1.8rem] p-5">
    <div class="mb-4 border-b border-[var(--app-border)] pb-4">
      <p class="text-xs font-black text-red-700">۲</p>
      <h4 class="font-black"><%= t('fields.tripExpenses') %></h4>
      <p class="mt-1 text-xs opacity-70"><%= t('fields.tripExpenseDesc') %></p>
    </div>
    <form method="POST" action="/vehicle-trips/<%= selectedTrip.id %>/expenses" class="mb-4 space-y-3 rounded-2xl border bg-slate-50/80 p-4 dark:bg-slate-900/30">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div><label class="customer-label"><%= t('fields.title') %></label><input name="title" placeholder="<%= t('fields.fuel') %>, <%= t('labels.customs') %>..." class="customer-input" required></div>
      <div><label class="customer-label"><%= t('fields.date') %></label><input name="expense_date" type="date" value="<%= new Date().toISOString().slice(0,10) %>" class="customer-input"></div>
      <div><label class="customer-label"><%= t('fields.stage') %></label><select name="stage" class="customer-input"><option value="loading"><%= t('labels.loading') %></option><option value="transit"><%= t('labels.in_transit') %></option><option value="customs"><%= t('labels.customs') %></option><option value="fuel"><%= t('fields.fuel') %></option><option value="delivery"><%= t('labels.delivery') %></option></select></div>
      <%- include('../partials/currency-fields', {
        prefix: 'tripExpense',
        amount: '',
        currency: defaultCurrency,
        amountLabelKey: 'fields.expenseAmount',
        amountRequired: true,
        labelClass: 'customer-label',
        inputClass: 'customer-input',
      }) %>
      <button class="w-full rounded-2xl bg-red-600 py-2.5 text-xs font-black text-white"><%= t('fields.addExpense') %></button>
    </form>
    <% if (!tripExpenses.length) { %>
      <p class="py-4 text-center text-sm opacity-60"><%= t('fields.noTripExpenses') %></p>
    <% } %>
    <% tripExpenses.forEach(exp => { %>
      <div class="flex justify-between gap-2 border-t py-3 text-sm">
        <div>
          <p class="font-black"><%= exp.title %></p>
          <p class="text-xs opacity-60"><%= exp.expense_date %> — <%= fa(exp.stage) %></p>
        </div>
        <div class="text-left">
          <p class="font-black text-red-700"><%= formatMoney(exp.amount, exp.currency) %></p>
          <form method="POST" action="/vehicle-trips/<%= selectedTrip.id %>/expenses/<%= exp.id %>/delete">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="text-xs text-red-600"><%= t('common.delete') %></button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
</div>
<% } %>

<div class="customer-card overflow-hidden rounded-[1.8rem]">
  <%- include('../partials/table-toolbar', { search, showPrint: true, buttons: [{ href: '/vehicle-trips?form=create', label: t('pages.vehicleTrips.add'), icon: 'plus', variant: 'primary' }] }) %>
  <div class="overflow-x-auto">
    <table class="min-w-full text-right text-sm">
      <thead><tr class="border-b bg-slate-50/80 text-xs text-slate-500"><th class="px-5 py-4"><%= t('common.row') %></th><th class="px-5 py-4"><%= t('fields.tripNo') %></th><th class="px-5 py-4"><%= t('fields.plateNo') %></th><th class="px-5 py-4"><%= t('fields.route') %></th><th class="px-5 py-4"><%= t('fields.weight') %></th><th class="px-5 py-4"><%= t('fields.totalFreight') %></th><th class="px-5 py-4"><%= t('fields.tripExpenses') %></th><th class="px-5 py-4"><%= t('common.actions') %></th></tr></thead>
      <tbody>
        <% rows.forEach((row, i) => { %>
          <tr class="border-t">
            <td class="px-5 py-4"><%= rowNo(pagination, i) %></td>
            <td class="px-5 py-4 font-black"><%= row.trip_no %></td>
            <td class="px-5 py-4"><%= row.plate_no %></td>
            <td class="px-5 py-4"><%= row.origin || '-' %> → <%= row.destination || '-' %></td>
            <td class="px-5 py-4"><%= money(row.total_weight_kg) %></td>
            <td class="px-5 py-4 font-black text-emerald-700"><%= Number(row.freight_usd) > 0 ? formatLegacyMoney(row, 'freight_usd', 'freight_currency') : '-' %></td>
            <td class="px-5 py-4 text-red-700"><%= Number(row.trip_expense_total) > 0 ? formatMoney(row.trip_expense_total, row.trip_expense_currency || defaultCurrency) : '-' %></td>
            <td class="px-5 py-4"><a href="/vehicle-trips?trip=<%= row.id %>" class="rounded-2xl bg-teal-600 px-3 py-2 text-xs font-black text-white"><%= t('common.viewDetails') %></a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="border-t px-5 py-4"><%- include('../partials/pagination') %></div>
</div>
</div>
