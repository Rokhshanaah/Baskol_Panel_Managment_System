<div class="space-y-5" dir="<%= dir %>">
<%- include('../partials/flash') %>

<div class="loading-card overflow-hidden rounded-[1.8rem]"><%- include('../partials/table-toolbar', { search, buttons: [{ href: '/containers', label: t('pages.containerLoading.manageContainers'), variant: 'outline' }] }) %>
<div class="overflow-x-auto"><table class="min-w-full text-right text-sm"><thead><tr class="border-b bg-slate-50 text-xs text-slate-500"><th class="px-5 py-4"><%= t('common.row') %></th><th class="px-5 py-4"><%= t('fields.container') %></th><th class="px-5 py-4"><%= t('fields.route') %></th><th class="px-5 py-4"><%= t('fields.status') %></th><th class="px-5 py-4"><%= t('fields.cbm') %></th><th class="px-5 py-4"><%= t('fields.freight') %></th><th class="px-5 py-4"><%= t('fields.items') %></th><th class="px-5 py-4"><%= t('common.actions') %></th></tr></thead><tbody class="divide-y"><% if(!containers.length){ %><tr><td colspan="8" class="py-12 text-center text-slate-500"><%= t('fields.noContainersToLoad') %></td></tr><% } %><% containers.forEach((c,i)=>{ %><tr class="hover:bg-amber-50/50"><td class="px-5 py-4 font-black text-slate-500"><%= rowNo(pagination,i) %></td><td class="px-5 py-4"><a class="font-black text-amber-700" href="/container-loading?container=<%= c.id %>"><%= c.container_no %></a></td><td class="px-5 py-4"><%= c.origin||'-' %> ← <%= c.destination||'-' %></td><td class="px-5 py-4"><%= fa(c.status) %></td><td class="px-5 py-4"><%= number(c.total_loaded_cbm,4) %></td><td class="px-5 py-4"><%= formatMoney(c.freight_usd) %></td><td class="px-5 py-4"><%= c.items_count||0 %></td><td class="px-5 py-4"><a href="/container-loading?container=<%= c.id %>" class="rounded-xl bg-amber-50 px-3 py-2 text-xs font-black text-amber-700"><%= t('fields.loadingSection') %></a></td></tr><% }) %></tbody></table></div><div class="border-t px-5 py-4"><%- include('../partials/pagination') %></div></div>

<% if (selectedContainer) { %>
<div class="loading-panel rounded-[1.8rem] p-5 md:p-6">
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between"><div><p class="text-xs font-black text-amber-700"><%= t('forms.loading.title') %></p><h3 class="mt-1 text-xl font-black"><%= selectedContainer.container_no %></h3><p class="mt-1 text-sm text-slate-500"><%= t('fields.volumeShort') %>: <%= number(selectedContainer.total_loaded_cbm,4) %> | <%= t('fields.freightPerCbm') %>: <%= formatMoney(selectedContainer.freight_per_cbm_usd) %></p></div><a href="/container-loading" class="rounded-xl bg-slate-100 px-4 py-2 text-sm font-black"><%= t('common.close') %></a></div>
  <form method="POST" action="/containers/<%= selectedContainer.id %>/cargo" class="mt-5 rounded-2xl bg-slate-50 p-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="<%= returnTo %>"><div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-5"><div class="xl:col-span-2"><label class="loading-label"><%= t('fields.cargo') %></label><select name="cargo_item_id" id="cargoSelect" class="loading-input" required><option value=""><%= t('fields.selectCargo') %></option><% for(const i of cargoItems){ %><option value="<%= i.id %>" data-cartons="<%= i.carton_count||0 %>" data-cbm="<%= i.total_cbm||0 %>" data-weight="<%= i.gross_weight_kg||0 %>"><%= i.cargo_code %> - <%= i.name %> - <%= i.customer_name||'' %></option><% } %></select></div><div><label class="loading-label"><%= t('forms.loading.loadCartons') %></label><input id="cargoCartons" name="cartons_loaded" type="number" min="1" class="loading-input" required></div><div><label class="loading-label"><%= t('forms.loading.loadCbm') %></label><input id="cargoCbm" name="cbm_loaded" type="number" step="0.0001" min="0" class="loading-input" required></div><div><label class="loading-label"><%= t('forms.loading.loadWeight') %></label><input id="cargoWeight" name="weight_loaded_kg" type="number" step="0.01" min="0" class="loading-input"></div><div class="md:col-span-2 xl:col-span-4"><label class="loading-label"><%= t('fields.notes') %></label><input name="item_notes" class="loading-input"></div><div class="flex items-end"><button class="h-11 w-full rounded-2xl bg-amber-600 text-sm font-black text-white"><%= t('fields.addItem') %></button></div></div></form>
  <div class="mt-5 overflow-x-auto rounded-2xl border"><table class="min-w-full text-right text-sm"><thead class="bg-slate-50"><tr><th class="px-4 py-3"><%= t('fields.cargo') %></th><th class="px-4 py-3"><%= t('fields.customer') %></th><th class="px-4 py-3"><%= t('fields.cartons') %></th><th class="px-4 py-3"><%= t('fields.cbm') %></th><th class="px-4 py-3"><%= t('fields.weight') %></th><th class="px-4 py-3"><%= t('fields.freightShare') %></th><th class="px-4 py-3"><%= t('common.actions') %></th></tr></thead><tbody class="divide-y"><% if(!selectedContainer.items?.length){ %><tr><td colspan="7" class="p-8 text-center text-slate-500"><%= t('fields.noCargoInContainer') %></td></tr><% } %><% for(const i of selectedContainer.items||[]){ %><tr><td class="px-4 py-3 font-black"><%= i.cargo_code||'-' %> - <%= i.cargo_name||'-' %></td><td class="px-4 py-3"><%= i.customer_name||'-' %></td><td class="px-4 py-3"><%= i.cartons_loaded||0 %></td><td class="px-4 py-3"><%= number(i.cbm_loaded,4) %></td><td class="px-4 py-3"><%= faWeight(i.weight_loaded_kg) %></td><td class="px-4 py-3 font-black"><%= formatMoney(i.freight_share_usd) %></td><td class="px-4 py-3"><form method="POST" action="/containers/<%= selectedContainer.id %>/cargo/<%= i.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="<%= returnTo %>"><button data-confirm="<%= t('fields.confirmRemoveCargoFromContainer') %>" class="rounded-xl bg-red-50 px-3 py-2 text-xs font-black text-red-600"><%= t('common.delete') %></button></form></td></tr><% } %></tbody></table></div>
</div>
<script>document.getElementById('cargoSelect')?.addEventListener('change',function(){const o=this.selectedOptions[0];if(!o)return;document.getElementById('cargoCartons').value=o.dataset.cartons||'';document.getElementById('cargoCbm').value=o.dataset.cbm||'';document.getElementById('cargoWeight').value=o.dataset.weight||'';});</script>
<% } %>
</div>
