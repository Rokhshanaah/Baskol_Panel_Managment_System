<div class="space-y-4 printable-area" dir="<%= dir %>">
<%- include('../partials/flash') %>

<% if (form) { %>
<div class="customer-panel rounded-[1.25rem] p-4 md:p-5">
  <h3 class="mb-4 text-sm font-black"><%= editingId ? t('forms.deliveries.edit') : t('forms.deliveries.new') %></h3>
  <form method="POST" action="/deliveries/save" class="grid grid-cols-1 gap-3 md:grid-cols-2">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="id" value="<%= editingId || '' %>">
    <input type="hidden" name="delivery_no" value="<%= form.delivery_no || '' %>">
    <div><label class="customer-label"><%= t('fields.customer') %></label><select name="customer_id" class="customer-input"><option value=""></option><% customers.forEach(c => { %><option value="<%= c.id %>" <%= String(form.customer_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div>
    <div><label class="customer-label"><%= t('fields.cargo') %></label><select name="cargo_item_id" class="customer-input"><option value=""></option><% cargoItems.forEach(c => { %><option value="<%= c.id %>" <%= String(form.cargo_item_id) === String(c.id) ? 'selected' : '' %>><%= c.cargo_code %> — <%= c.name %></option><% }) %></select></div>
    <div><label class="customer-label"><%= t('fields.trip') %></label><select name="vehicle_trip_id" class="customer-input"><option value=""></option><% trips.forEach(tr => { %><option value="<%= tr.id %>" <%= String(form.vehicle_trip_id) === String(tr.id) ? 'selected' : '' %>><%= tr.trip_no %> (<%= tr.plate_no %>)</option><% }) %></select></div>
    <div><label class="customer-label"><%= t('fields.recipient') %></label><input name="recipient_name" value="<%= form.recipient_name || '' %>" class="customer-input"></div>
    <div><label class="customer-label"><%= t('fields.deliveredAt') %></label><input name="delivered_at" type="datetime-local" value="<%= form.delivered_at ? String(form.delivered_at).slice(0, 16) : '' %>" class="customer-input"></div>
    <div><label class="customer-label"><%= t('fields.weight') %></label><input name="weight_kg" type="number" step="0.01" value="<%= form.weight_kg || '' %>" class="customer-input"></div>
    <div class="md:col-span-2 flex justify-end gap-2">
      <a href="/deliveries" class="inline-flex h-9 items-center rounded-xl bg-slate-100 px-4 text-xs font-black"><%= t('common.cancel') %></a>
      <button class="inline-flex h-9 items-center rounded-xl bg-teal-600 px-5 text-xs font-black text-white"><%= t('common.save') %></button>
    </div>
  </form>
</div>
<% } %>

<div class="customer-card overflow-hidden">
  <%- include('../partials/table-toolbar', { search, showPrint: true, buttons: [{ href: '/deliveries?form=create', label: t('pages.deliveries.add'), icon: 'plus', variant: 'primary' }] }) %>
  <div class="overflow-x-auto">
    <table class="data-table min-w-full">
      <thead>
        <tr>
          <th class="data-table__th data-table__th--row"><%= t('common.row') %></th>
          <th class="data-table__th"><%= t('fields.deliveryNo') %></th>
          <th class="data-table__th"><%= t('fields.customer') %></th>
          <th class="data-table__th"><%= t('fields.cargo') %></th>
          <th class="data-table__th"><%= t('fields.trip') %></th>
          <th class="data-table__th"><%= t('fields.deliveredAt') %></th>
          <th class="data-table__th data-table__th--actions"><%= t('common.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="7" class="data-table__empty"><%= t('pages.deliveries.empty') %></td></tr>
        <% } %>
        <% rows.forEach((row, i) => { %>
          <tr class="data-table__row">
            <td class="data-table__td data-table__td--row"><%= rowNo(pagination, i) %></td>
            <td class="data-table__td data-table__td--code"><%= row.delivery_no %></td>
            <td class="data-table__td"><%= row.customer_name || '-' %></td>
            <td class="data-table__td"><%= row.cargo_name || '-' %></td>
            <td class="data-table__td"><%= row.trip_no || '-' %></td>
            <td class="data-table__td"><%= row.delivered_at ? formatDateTime(row.delivered_at) : '-' %></td>
            <td class="data-table__td data-table__td--actions">
              <%- include('../partials/table-row-actions', {
                editHref: '/deliveries?edit=' + row.id,
                deleteAction: '/deliveries/' + row.id + '/delete',
                confirmMessage: t('fields.confirmDeleteDelivery'),
              }) %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="border-t border-[var(--app-border)] px-3 py-3"><%- include('../partials/pagination') %></div>
</div>
</div>
