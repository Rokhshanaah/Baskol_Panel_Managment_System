<div class="space-y-5" dir="<%= dir %>">
<%- include('../partials/flash') %>
<% const c = billing.cargo; const mode = billing.billingMode; %>

<div class="page-panel rounded-[1.8rem] p-5 md:p-6">
  <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-200 pb-5">
    <div>
      <p class="text-xs font-black text-teal-700"><%= t('fields.customerAccount') %></p>
      <h3 class="text-lg font-black"><%= c.cargo_code %> — <%= c.name %></h3>
      <p class="mt-1 text-sm text-slate-600"><%= c.customer_code %> — <%= c.customer_name %></p>
      <p class="mt-1 text-xs text-slate-500"><%= t('fields.billingMode') %>: <span class="font-black"><%= fa(mode) %></span><% if (c.contract_route) { %> · <%= c.contract_route %><% } %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/cargo-items?edit=<%= c.id %>" class="rounded-2xl bg-slate-100 px-4 py-2 text-xs font-black"><%= t('common.edit') %></a>
      <a href="/payments?form=create&cargo=<%= c.id %>" class="rounded-2xl bg-teal-600 px-4 py-2 text-xs font-black text-white"><%= t('pages.payments.add') %></a>
      <a href="/cargo-items" class="rounded-2xl bg-slate-100 px-4 py-2 text-xs font-black"><%= t('fields.back') %></a>
    </div>
  </div>

  <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <% if (mode === 'itemized') { %>
    <div class="rounded-2xl bg-slate-50 p-4 dark:bg-slate-900/40"><p class="text-xs font-black text-slate-600"><%= t('fields.totalExpenses') %></p><p class="text-xl font-black"><%= formatMoney(billing.expensesTotal, defaultCurrency) %></p></div>
    <div class="rounded-2xl bg-amber-50 p-4 dark:bg-amber-500/10"><p class="text-xs font-black text-amber-700"><%= t('fields.commissionAmount') %> (<%= number(billing.commissionPercent, 2) %>%)</p><p class="text-xl font-black text-amber-900"><%= formatMoney(billing.commissionAmount, defaultCurrency) %></p></div>
    <% } else { %>
    <div class="rounded-2xl bg-teal-50 p-4 dark:bg-teal-500/10 sm:col-span-2"><p class="text-xs font-black text-teal-700"><%= t('fields.contractAmount') %></p><p class="text-xl font-black text-teal-900"><%= formatStoredMoney(c, 'contract_amount', 'contract_currency') %></p></div>
    <% } %>
    <div class="rounded-2xl bg-emerald-50 p-4 dark:bg-emerald-500/10"><p class="text-xs font-black text-emerald-700"><%= t('fields.totalPaid') %></p><p class="text-xl font-black text-emerald-900"><%= formatMoney(billing.paidTotal, defaultCurrency) %></p></div>
    <div class="rounded-2xl <%= billing.balanceDue > 0 ? 'bg-red-50 dark:bg-red-500/10' : 'bg-emerald-50 dark:bg-emerald-500/10' %> p-4"><p class="text-xs font-black"><%= t('fields.balanceDue') %></p><p class="text-xl font-black"><%= formatMoney(billing.balanceDue, defaultCurrency) %></p></div>
  </div>
  <% if (mode === 'itemized' && billing.freightShareTotal > 0 && billing.expensesTotal <= 0.004 && billing.legs.length === 0) { %>
  <p class="mt-3 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-900"><%= t('fields.freightShareFallback') %>: <%= formatMoney(billing.freightShareTotal, defaultCurrency) %></p>
  <% } %>
</div>

<div class="grid grid-cols-1 gap-5 xl:grid-cols-3">
  <div class="page-panel rounded-[1.8rem] p-5 xl:col-span-1">
    <h4 class="mb-1 font-black"><%= t('fields.billingSettings') %></h4>
    <p class="mb-4 text-xs text-slate-500"><%= mode === 'fixed_contract' ? t('fields.billingFixedHint') : t('fields.billingItemizedHint') %></p>
    <form method="POST" action="/cargo-items/<%= c.id %>/billing/settings" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="cargo-label"><%= t('fields.billingMode') %></label>
        <select name="billing_mode" id="billingModeSelect" class="cargo-input">
          <option value="itemized" <%= mode==='itemized'?'selected':'' %>><%= t('fields.billingItemized') %></option>
          <option value="fixed_contract" <%= mode==='fixed_contract'?'selected':'' %>><%= t('fields.billingFixed') %></option>
        </select>
      </div>
      <div id="itemizedFields" class="space-y-4 <%= mode==='fixed_contract'?'hidden':'' %>">
        <div>
          <label class="cargo-label"><%= t('fields.commissionPercent') %></label>
          <input name="commission_percent" type="number" step="0.01" min="0" value="<%= c.commission_percent ?? 0 %>" class="cargo-input">
        </div>
      </div>
      <div id="contractFields" class="space-y-4 <%= mode==='itemized'?'hidden':'' %>">
        <div>
          <label class="cargo-label"><%= t('fields.contractRoute') %></label>
          <input name="contract_route" value="<%= c.contract_route || '' %>" class="cargo-input" placeholder="<%= t('fields.origin') %> → <%= t('fields.destination') %>">
        </div>
        <%- include('../partials/currency-fields', { prefix: 'contract', amount: c.contract_amount, currency: c.contract_currency || defaultCurrency, amountRequired: false, labelClass: 'cargo-label', inputClass: 'cargo-input' }) %>
      </div>
      <button class="h-11 w-full rounded-2xl bg-teal-600 text-sm font-black text-white"><%= t('common.save') %></button>
    </form>
  </div>

  <% if (mode === 'itemized') { %>
  <div class="page-panel rounded-[1.8rem] p-5 xl:col-span-2">
    <div class="mb-4 flex flex-wrap items-start justify-between gap-3 border-b pb-4">
      <div>
        <h4 class="font-black"><%= t('fields.routeLegs') %></h4>
        <p class="mt-1 text-xs text-slate-500"><%= t('forms.cargoLocations.expenseDesc') %> <%= t('fields.routeExpenseCashboxHint') %></p>
      </div>
      <a href="/cargo-locations?form=create&cargo=<%= c.id %>" class="inline-flex h-10 items-center rounded-2xl bg-teal-600 px-5 text-xs font-black text-white"><%= t('fields.addRouteExpense') %></a>
    </div>
    <div class="overflow-x-auto rounded-2xl border">
      <table class="min-w-full text-right text-sm">
        <thead class="bg-slate-50 text-xs text-slate-500"><tr>
          <th class="px-4 py-3"><%= t('common.row') %></th>
          <th class="px-4 py-3"><%= t('fields.date') %></th>
          <th class="px-4 py-3"><%= t('fields.route') %></th>
          <th class="px-4 py-3"><%= t('fields.title') %></th>
          <th class="px-4 py-3"><%= t('fields.notes') %></th>
          <th class="px-4 py-3"><%= t('fields.amount') %></th>
          <th class="px-4 py-3"><%= t('common.actions') %></th>
        </tr></thead>
        <tbody class="divide-y">
          <% if (!billing.legs.length) { %><tr><td colspan="7" class="px-4 py-10 text-center text-slate-500"><%= t('fields.noRouteExpenses') %></td></tr><% } %>
          <% billing.legs.forEach((leg, i) => { %>
          <tr class="hover:bg-teal-50/40">
            <td class="px-4 py-3 font-black text-slate-500"><%= i + 1 %></td>
            <td class="px-4 py-3 text-xs"><%= String(leg.expense_date || '').slice(0, 10) || '-' %></td>
            <td class="px-4 py-3 text-xs"><% if (leg.route_from || leg.route_to) { %><% if (leg.route_from && leg.route_to) { %>از <%= leg.route_from %> به <%= leg.route_to %><% } else if (leg.route_to) { %>به <%= leg.route_to %><% } else { %>از <%= leg.route_from %><% } %><% if (leg.is_allocated) { %><br><span class="text-teal-700"><%= t('fields.allocatedFromContainer') %>: <%= leg.allocation_note %></span><% } %><% } else if (leg.is_allocated) { %><span class="text-teal-700"><%= leg.allocation_note %></span><% } else { %>-<% } %></td>
            <td class="px-4 py-3 font-black"><%= leg.title %></td>
            <td class="px-4 py-3 text-xs text-slate-600"><%= leg.notes || '-' %></td>
            <td class="px-4 py-3 font-black"><%= formatStoredMoney(leg, 'amount', 'currency') %></td>
            <td class="px-4 py-3"><% if (!leg.is_allocated) { %><form method="POST" action="/cargo-items/<%= c.id %>/billing/expenses/<%= leg.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button data-confirm="<%= t('fields.confirmDeleteExpense') %>" class="rounded-xl bg-red-50 px-3 py-2 text-xs font-black text-red-600"><%= t('common.delete') %></button></form><% } else { %><span class="text-xs text-slate-400">—</span><% } %></td>
          </tr>
          <% }) %>
        </tbody>
        <% if (billing.legs.length) { %>
        <tfoot class="border-t bg-slate-50 font-black"><tr>
          <td colspan="5" class="px-4 py-3 text-left"><%= t('fields.totalExpenses') %></td>
          <td class="px-4 py-3"><%= formatMoney(billing.expensesTotal, defaultCurrency) %></td>
          <td></td>
        </tr></tfoot>
        <% } %>
      </table>
    </div>
  </div>
  <% } else { %>
  <div class="page-panel rounded-[1.8rem] p-5 xl:col-span-2">
    <h4 class="font-black"><%= t('fields.billingFixed') %></h4>
    <p class="mt-2 text-sm text-slate-600"><%= t('fields.billingFixedHint') %></p>
    <dl class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
      <div class="rounded-2xl bg-slate-50 p-4"><dt class="text-xs font-black text-slate-500"><%= t('fields.contractRoute') %></dt><dd class="mt-1 font-black"><%= c.contract_route || '—' %></dd></div>
      <div class="rounded-2xl bg-teal-50 p-4"><dt class="text-xs font-black text-teal-700"><%= t('fields.totalDue') %></dt><dd class="mt-1 text-lg font-black"><%= formatStoredMoney(c, 'contract_amount', 'contract_currency') %></dd></div>
    </dl>
  </div>
  <% } %>
</div>

<% if (payments.length) { %>
<div class="page-panel overflow-hidden rounded-[1.8rem]">
  <div class="border-b px-5 py-4"><h4 class="font-black"><%= t('pages.payments.listTitle') %></h4></div>
  <div class="overflow-x-auto"><table class="min-w-full text-right text-sm"><thead class="bg-slate-50 text-xs"><tr>
    <th class="px-4 py-3"><%= t('fields.number') %></th><th class="px-4 py-3"><%= t('fields.date') %></th><th class="px-4 py-3"><%= t('fields.amount') %></th><th class="px-4 py-3"><%= t('fields.method') %></th><th class="px-4 py-3"><%= t('fields.notes') %></th>
  </tr></thead><tbody class="divide-y"><% payments.forEach(p => { %><tr>
    <td class="px-4 py-3 font-black"><%= p.payment_no %></td>
    <td class="px-4 py-3"><%= String(p.payment_date || '').slice(0, 10) %></td>
    <td class="px-4 py-3 font-black"><%= formatMoney(p.amount, p.currency) %></td>
    <td class="px-4 py-3"><%= fa(p.payment_method) %></td>
    <td class="px-4 py-3 text-xs"><%= p.notes || '-' %></td>
  </tr><% }) %></tbody></table></div>
</div>
<% } %>
</div>

<script>
(function(){
  const sel=document.getElementById('billingModeSelect');
  const itemized=document.getElementById('itemizedFields');
  const contract=document.getElementById('contractFields');
  function sync(){const m=sel?.value||'itemized';itemized?.classList.toggle('hidden',m!=='itemized');contract?.classList.toggle('hidden',m!=='fixed_contract');}
  sel?.addEventListener('change',sync);
})();
</script>
