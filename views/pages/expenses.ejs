<div class="space-y-5" dir="<%= dir %>">
<%- include('../partials/flash') %>
<% const expenseScope = typeof scope !== 'undefined' ? scope : ''; const expenseCategory = typeof category !== 'undefined' ? category : ''; %>
<% if(form){ %><div class="expense-panel rounded-[1.8rem] p-5 md:p-6"><div class="mb-5 flex justify-between border-b pb-5"><div><h3 class="font-black"><%= editingId?t('forms.expenses.edit'):t('forms.expenses.new') %></h3><p class="mt-1 text-xs text-slate-500"><%= t('forms.expenses.desc') %></p></div><a href="/expenses" class="rounded-xl bg-slate-100 px-4 py-2 text-sm font-black"><%= t('common.closeForm') %></a></div><form method="POST" action="/expenses/save"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= editingId||'' %>"><div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
<div><label class="expense-label"><%= t('fields.number') %></label><input name="expense_no" value="<%= form.expense_no||'' %>" class="expense-input" required></div><div><label class="expense-label"><%= t('fields.type') %></label><select id="expenseScope" name="scope" class="expense-input"><option value="company" <%= form.scope==='company'?'selected':'' %>><%= t('fields.company') %></option><option value="cargo" <%= form.scope==='cargo'?'selected':'' %>><%= t('fields.cargo') %></option><option value="container" <%= form.scope==='container'?'selected':'' %>><%= t('fields.container') %></option></select></div><div><label class="expense-label"><%= t('fields.title') %></label><input name="title" value="<%= form.title||'' %>" class="expense-input" required></div><div><label class="expense-label"><%= t('fields.category') %></label><input name="category" value="<%= form.category||'' %>" class="expense-input"></div>
<div data-scope="cargo container"><label class="expense-label"><%= t('fields.customer') %></label><select name="customer_id" class="expense-input"><option value=""><%= t('fields.select') %></option><% for(const c of customers){ %><option value="<%= c.id %>" <%= String(form.customer_id||'')===String(c.id)?'selected':'' %>><%= c.customer_code %> - <%= c.name %></option><% } %></select></div><div data-scope="cargo"><label class="expense-label"><%= t('fields.cargo') %></label><select name="cargo_item_id" class="expense-input"><option value=""><%= t('fields.select') %></option><% for(const c of cargoItems){ %><option value="<%= c.id %>" <%= String(form.cargo_item_id||'')===String(c.id)?'selected':'' %>><%= c.cargo_code %> - <%= c.name %></option><% } %></select></div><div data-scope="container"><label class="expense-label"><%= t('fields.container') %></label><select name="shipping_container_id" class="expense-input"><option value=""><%= t('fields.select') %></option><% for(const c of containers){ %><option value="<%= c.id %>" <%= String(form.shipping_container_id||'')===String(c.id)?'selected':'' %>><%= c.container_no %></option><% } %></select></div>
<%- include('../partials/currency-fields', { prefix: 'expense', amount: form.amount, currency: form.currency, amountRequired: true, labelClass: 'expense-label', inputClass: 'expense-input' }) %>
<div><label class="expense-label"><%= t('fields.date') %></label><input name="expense_date" type="date" value="<%= String(form.expense_date||'').slice(0,10) %>" class="expense-input"></div>
<div data-scope="cargo container"><label class="expense-label"><%= t('fields.routeTo') %></label><input name="route_to" value="<%= form.route_to||'' %>" class="expense-input"></div>
<div data-scope="cargo container"><label class="expense-label"><%= t('fields.routeFrom') %></label><input name="route_from" value="<%= form.route_from||'' %>" class="expense-input"></div>
<div data-scope="cargo container" class="flex items-end gap-2 pb-1"><label class="flex items-center gap-2 text-sm font-black"><input type="checkbox" name="billable_to_customer" value="1" <%= form.billable_to_customer!==0&&form.billable_to_customer!=='0'?'checked':'' %> class="rounded border-slate-300"><%= t('fields.billableToCustomer') %></label></div>
<div class="md:col-span-2 xl:col-span-3"><label class="expense-label"><%= t('fields.notes') %></label><textarea name="notes" rows="2" class="expense-input !h-auto py-3"><%= form.notes||'' %></textarea></div></div><div class="mt-5 flex justify-end gap-3"><a href="/expenses" class="h-11 inline-flex items-center rounded-2xl bg-slate-100 px-5 text-sm font-black"><%= t('common.cancel') %></a><button class="h-11 rounded-2xl bg-teal-600 px-6 text-sm font-black text-white"><%= t('common.save') %></button></div></form></div><script>
function expenseUI(){
  const s=document.getElementById('expenseScope')?.value||'company';
  document.querySelectorAll('[data-scope]').forEach(x=>x.style.display=x.dataset.scope.split(' ').includes(s)?'block':'none');
}
document.getElementById('expenseScope')?.addEventListener('input', expenseUI);
expenseUI();
</script><% } %>

<%- include('../partials/expense-scope-tabs', { baseUrl: '/expenses', activeScope: expenseScope, from: '', to: '', category: expenseCategory, extraQuery: {} }) %>

<form method="GET" class="no-print flex flex-wrap items-end gap-3 rounded-2xl border bg-white p-4 shadow-sm">
  <div><label class="mb-1 block text-xs font-black text-slate-500"><%= t('fields.category') %></label><input name="category" value="<%= expenseCategory %>" class="h-10 rounded-xl border px-3 text-sm" placeholder="<%= t('fields.category') %>"></div>
  <% if (expenseScope) { %><input type="hidden" name="scope" value="<%= expenseScope %>"><% } %>
  <button class="h-10 rounded-xl bg-teal-600 px-5 text-xs font-black text-white"><%= t('fields.apply') %></button>
</form>

<div class="overflow-hidden rounded-[1.8rem] border bg-white shadow-sm"><%- include('../partials/table-toolbar', { search, buttons: [{ href: '/expenses?form=create', label: t('pages.expenses.add'), icon: 'plus', variant: 'primary' }] }) %><div class="overflow-x-auto"><table class="min-w-full text-right text-sm"><thead class="bg-slate-50"><tr><th class="px-4 py-3"><%= t('common.row') %></th><th class="px-4 py-3"><%= t('fields.number') %></th><th class="px-4 py-3"><%= t('fields.type') %></th><th class="px-4 py-3"><%= t('fields.title') %></th><th class="px-4 py-3"><%= t('fields.route') %></th><th class="px-4 py-3"><%= t('fields.category') %></th><th class="px-4 py-3"><%= t('reportCols.expenseVia') %></th><th class="px-4 py-3"><%= t('fields.relation') %></th><th class="px-4 py-3"><%= t('fields.amount') %></th><th class="px-4 py-3"><%= t('reportCols.cashboxFlow') %></th><th class="px-4 py-3"><%= t('common.actions') %></th></tr></thead><tbody class="divide-y"><% if(!rows.length){ %><tr><td colspan="11" class="p-10 text-center text-slate-500"><%= t('pages.expenses.empty') %></td></tr><% } %><% rows.forEach((r, i) => {
  let rel = r.trip_no ? `${r.trip_no} / ${r.plate_no || '-'}` : (r.customer_name || r.cargo_name || r.container_no || '-');
  let via = t('expenseVia.company');
  if (r.scope === 'vehicle_trip') via = `${t('expenseVia.vehicleTrip')} — ${r.trip_no || '-'}`;
  else if (r.scope === 'container') via = `${t('expenseVia.container')} — ${r.container_no || '-'}`;
  else if (r.scope === 'cargo') via = `${t('expenseVia.cargo')} — ${r.cargo_code || r.customer_name || '-'}`;
  let routeTxt = '-';
  if (r.route_from && r.route_to) routeTxt = `از ${r.route_from} به ${r.route_to}`;
  else if (r.route_to) routeTxt = `به ${r.route_to}`;
  else if (r.route_from) routeTxt = `از ${r.route_from}`;
%><tr><td class="px-4 py-3 font-black text-slate-500"><%= rowNo(pagination, i) %></td><td class="px-4 py-3 font-black"><%= r.expense_no %></td><td class="px-4 py-3"><%= fa(r.scope) %></td><td class="px-4 py-3"><%= r.title %></td><td class="px-4 py-3 text-xs"><%= routeTxt %></td><td class="px-4 py-3"><%= faStage(r.category) %></td><td class="px-4 py-3 text-xs"><%= via %></td><td class="px-4 py-3"><%= rel %></td><td class="px-4 py-3 font-black"><%= formatMoney(r.amount, r.currency) %></td><td class="px-4 py-3 text-xs text-red-700 font-black"><%= t('expenseVia.cashbox') %></td><td class="px-4 py-3"><div class="flex gap-2"><% if (r.scope !== 'vehicle_trip') { %><a href="/expenses?edit=<%= r.id %>" class="rounded-xl bg-slate-100 px-3 py-2 text-xs font-black"><%= t('common.edit') %></a><form method="POST" action="/expenses/<%= r.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button data-confirm="<%= t('fields.confirmDeleteExpense') %>" class="rounded-xl bg-red-50 px-3 py-2 text-xs font-black text-red-600"><%= t('common.delete') %></button></form><% } else { %><a href="/vehicle-trips?trip=<%= r.vehicle_trip_id %>" class="rounded-xl bg-teal-50 px-3 py-2 text-xs font-black text-teal-700"><%= t('common.viewDetails') %></a><% } %></div></td></tr><% }) %></tbody></table></div><div class="border-t px-5 py-4"><%- include('../partials/pagination') %></div></div>
</div>
