<div class="space-y-5" dir="<%= dir %>">
<%- include('../partials/flash') %>

<% if (form) { %>
<div class="payment-panel rounded-[1.8rem] p-5 md:p-6"><div class="mb-5 flex justify-between border-b pb-5"><div><h3 class="font-black"><%= editingId?t('forms.payments.edit'):t('forms.payments.new') %></h3><p class="mt-1 text-xs text-slate-500"><%= t('forms.payments.desc') %></p></div><a href="/payments" class="rounded-xl bg-slate-100 px-4 py-2 text-sm font-black"><%= t('common.closeForm') %></a></div>
<form method="POST" action="/payments/save"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= editingId||'' %>"><div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
<div><label class="payment-label"><%= t('fields.paymentNo') %></label><input name="payment_no" value="<%= form.payment_no||'' %>" class="payment-input" required></div>
<div><label class="payment-label"><%= t('fields.customer') %></label><select name="customer_id" class="payment-input" required><option value=""><%= t('fields.select') %></option><% for(const c of customers){ %><option value="<%= c.id %>" <%= String(form.customer_id||'')===String(c.id)?'selected':'' %>><%= c.customer_code %> - <%= c.name %></option><% } %></select></div>
<div><label class="payment-label"><%= t('fields.optionalContainer') %></label><select name="shipping_container_id" class="payment-input"><option value=""><%= t('fields.noContainer') %></option><% for(const c of containers){ %><option value="<%= c.id %>" <%= String(form.shipping_container_id||'')===String(c.id)?'selected':'' %>><%= c.container_no %></option><% } %></select></div>
<div><label class="payment-label"><%= t('fields.optionalCargo') %></label><select name="cargo_item_id" class="payment-input"><option value=""><%= t('fields.noCargo') %></option><% for(const c of cargoItems){ %><option value="<%= c.id %>" <%= String(form.cargo_item_id||'')===String(c.id)?'selected':'' %>><%= c.cargo_code %> - <%= c.name %></option><% } %></select></div>
<%- include('../partials/currency-fields', { prefix: 'payment', amount: form.amount, currency: form.currency, amountRequired: true, labelClass: 'payment-label', inputClass: 'payment-input' }) %>
<div><label class="payment-label"><%= t('fields.date') %></label><input name="payment_date" type="date" value="<%= String(form.payment_date||'').slice(0,10) %>" class="payment-input"></div>
<div><label class="payment-label"><%= t('fields.paymentMethod') %></label><select name="payment_method" class="payment-input"><% for(const v of ['cash','bank','transfer']){ %><option value="<%= v %>" <%= form.payment_method===v?'selected':'' %>><%= fa(v) %></option><% } %></select></div>
<div class="md:col-span-2 xl:col-span-3"><label class="payment-label"><%= t('fields.notes') %></label><textarea name="notes" rows="2" class="payment-input !h-auto py-3"><%= form.notes||'' %></textarea></div>
</div><div class="mt-5 flex justify-end gap-3"><a href="/payments" class="h-11 inline-flex items-center rounded-2xl bg-slate-100 px-5 text-sm font-black"><%= t('common.cancel') %></a><button class="h-11 rounded-2xl bg-teal-600 px-6 text-sm font-black text-white"><%= t('common.save') %></button></div></form></div>
<% } %>

<div class="overflow-hidden rounded-[1.8rem] border bg-white shadow-sm"><%- include('../partials/table-toolbar', { search, buttons: [{ href: '/payments?form=create', label: t('pages.payments.add'), icon: 'plus', variant: 'primary' }] }) %>
<div class="overflow-x-auto"><table class="min-w-full text-right text-sm"><thead class="bg-slate-50"><tr><th class="px-4 py-3"><%= t('common.row') %></th><th class="px-4 py-3"><%= t('fields.number') %></th><th class="px-4 py-3"><%= t('fields.customer') %></th><th class="px-4 py-3"><%= t('fields.relation') %></th><th class="px-4 py-3"><%= t('fields.amount') %></th><th class="px-4 py-3"><%= t('fields.method') %></th><th class="px-4 py-3"><%= t('common.actions') %></th></tr></thead><tbody class="divide-y"><% if(!rows.length){ %><tr><td colspan="7" class="p-10 text-center text-slate-500"><%= t('pages.payments.empty') %></td></tr><% } %><% rows.forEach((r,i)=>{ const rel=r.container_no||r.cargo_name||'-'; %><tr><td class="px-4 py-3 font-black text-slate-500"><%= rowNo(pagination,i) %></td><td class="px-4 py-3 font-black"><%= r.payment_no %></td><td class="px-4 py-3"><%= r.customer_name||'-' %></td><td class="px-4 py-3"><%= rel %></td><td class="px-4 py-3 font-black"><%= formatMoney(r.amount, r.currency) %></td><td class="px-4 py-3"><%= fa(r.payment_method) %></td><td class="px-4 py-3"><div class="flex gap-2"><a href="/payments?edit=<%= r.id %>" class="rounded-xl bg-slate-100 px-3 py-2 text-xs font-black"><%= t('common.edit') %></a><form method="POST" action="/payments/<%= r.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button data-confirm="<%= t('fields.confirmDeletePayment') %>" class="rounded-xl bg-red-50 px-3 py-2 text-xs font-black text-red-600"><%= t('common.delete') %></button></form></div></td></tr><% }) %></tbody></table></div><div class="border-t px-5 py-4"><%- include('../partials/pagination') %></div></div>
</div>
