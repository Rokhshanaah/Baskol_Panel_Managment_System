<div class="space-y-5 printable-area" dir="<%= dir %>">
<%- include('../partials/flash') %>
<% if (form) { %>
<div class="customer-panel rounded-[1.8rem] p-5 md:p-6">
  <h3 class="text-base font-black mb-4"><%= editingId ? t('forms.vehicles.edit') : t('forms.vehicles.new') %></h3>
  <form method="POST" action="/vehicles/save" class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= editingId || '' %>"><input type="hidden" name="vehicle_code" value="<%= form.vehicle_code || '' %>">
    <div><label class="customer-label"><%= t('fields.plateNo') %></label><input name="plate_no" value="<%= form.plate_no || '' %>" class="customer-input" required></div>
    <div><label class="customer-label"><%= t('fields.vehicleType') %></label><select name="vehicle_type" class="customer-input"><option value="truck" <%= form.vehicle_type==='truck'?'selected':'' %>><%= t('labels.truck') %></option><option value="trailer" <%= form.vehicle_type==='trailer'?'selected':'' %>><%= t('fields.trailer') %></option></select></div>
    <div><label class="customer-label"><%= t('fields.brandModel') %></label><input name="brand_model" value="<%= form.brand_model || '' %>" class="customer-input"></div>
    <div><label class="customer-label"><%= t('fields.capacityKg') %></label><input name="capacity_kg" type="number" step="0.01" value="<%= form.capacity_kg || '' %>" class="customer-input"></div>
    <div><label class="customer-label"><%= t('fields.capacityCbm') %></label><input name="capacity_cbm" type="number" step="0.0001" value="<%= form.capacity_cbm || '' %>" class="customer-input"></div>
    <div><label class="customer-label"><%= t('fields.ownerName') %></label><input name="owner_name" value="<%= form.owner_name || '' %>" class="customer-input"></div>
    <div><label class="customer-label"><%= t('fields.driver') %></label><input name="default_driver_name" value="<%= form.default_driver_name || '' %>" class="customer-input"></div>
    <div><label class="customer-label"><%= t('fields.driverPhone') %></label><input name="default_driver_phone" value="<%= form.default_driver_phone || '' %>" class="customer-input"></div>
    <div class="md:col-span-2 xl:col-span-3 flex justify-end gap-3"><a href="/vehicles" class="h-11 inline-flex items-center rounded-2xl bg-slate-100 px-5 text-sm font-black"><%= t('common.cancel') %></a><button class="h-11 rounded-2xl bg-teal-600 px-6 text-sm font-black text-white"><%= t('common.save') %></button></div>
  </form>
</div>
<% } %>
<div class="customer-card overflow-hidden rounded-[1.8rem]">
  <%- include('../partials/table-toolbar', { search, showPrint: true, buttons: [{ href: '/vehicles?form=create', label: t('pages.vehicles.add'), icon: 'plus', variant: 'primary' }, { href: '/vehicle-trips', label: t('pages.vehicleTrips.title'), icon: 'truck', variant: 'secondary' }] }) %>
  <div class="overflow-x-auto"><table class="min-w-full text-right text-sm"><thead><tr class="border-b border-slate-200 bg-slate-50/80 text-xs text-slate-500"><th class="px-5 py-4"><%= t('common.row') %></th><th class="px-5 py-4"><%= t('fields.code') %></th><th class="px-5 py-4"><%= t('fields.plateNo') %></th><th class="px-5 py-4"><%= t('fields.brandModel') %></th><th class="px-5 py-4"><%= t('fields.driver') %></th><th class="px-5 py-4"><%= t('common.actions') %></th></tr></thead><tbody class="divide-y divide-slate-200/80 bg-white/55">
  <% if (!rows.length) { %><tr><td colspan="6" class="px-5 py-12 text-center text-slate-500"><%= t('pages.vehicles.empty') %></td></tr><% } %>
  <% rows.forEach((row, i) => { %><tr><td class="px-5 py-4"><%= rowNo(pagination, i) %></td><td class="px-5 py-4 font-black"><%= row.vehicle_code %></td><td class="px-5 py-4 font-black"><%= row.plate_no %></td><td class="px-5 py-4"><%= row.brand_model || '-' %></td><td class="px-5 py-4"><%= row.default_driver_name || '-' %></td><td class="px-5 py-4"><div class="flex gap-2"><a href="/vehicle-trips?form=create&vehicle=<%= row.id %>" class="rounded-2xl bg-blue-50 px-3 py-2 text-xs font-black text-blue-700"><%= t('pages.vehicleTrips.add') %></a><a href="/vehicles?edit=<%= row.id %>" class="rounded-2xl bg-slate-100 px-3 py-2 text-xs font-black"><%= t('common.edit') %></a><form method="POST" action="/vehicles/<%= row.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button data-confirm="<%= t('common.confirm') %>" class="rounded-2xl bg-red-50 px-3 py-2 text-xs font-black text-red-600"><%= t('common.delete') %></button></form></div></td></tr><% }) %>
  </tbody></table></div><div class="border-t px-5 py-4"><%- include('../partials/pagination') %></div>
</div>
</div>
