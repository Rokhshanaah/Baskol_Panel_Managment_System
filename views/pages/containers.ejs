<div class="space-y-5" dir="<%= dir %>">
<%- include('../partials/flash') %>
<% if(form){ %><div class="container-panel rounded-[1.8rem] p-5 md:p-6"><div class="mb-5 flex justify-between border-b pb-5"><div><h3 class="font-black"><%= editingId?t('forms.containers.edit'):t('forms.containers.new') %></h3><p class="mt-1 text-xs text-slate-500"><%= t('forms.containers.desc') %></p></div><a href="/containers" class="rounded-2xl bg-slate-100 px-4 py-2 text-sm font-black"><%= t('common.closeForm') %></a></div><form method="POST" action="/containers/save"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= editingId||'' %>"><div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
<div><label class="container-label"><%= t('fields.containerNo') %></label><input name="container_no" value="<%= form.container_no||'' %>" class="container-input" required></div><div><label class="container-label"><%= t('fields.sealNo') %></label><input name="seal_no" value="<%= form.seal_no||'' %>" class="container-input"></div><div><label class="container-label"><%= t('fields.bookingNo') %></label><input name="booking_no" value="<%= form.booking_no||'' %>" class="container-input"></div><div><label class="container-label"><%= t('fields.shipName') %></label><input name="ship_name" value="<%= form.ship_name||'' %>" class="container-input"></div><div><label class="container-label"><%= t('fields.containerType') %></label><select name="container_type" class="container-input"><% for(const v of ['20FT','40FT','40HQ','45HQ']){ %><option value="<%= v %>" <%= form.container_type===v?'selected':'' %>><%= fa(v) %></option><% } %></select></div><div><label class="container-label"><%= t('fields.origin') %></label><input name="origin" value="<%= form.origin||'' %>" class="container-input"></div><div><label class="container-label"><%= t('fields.destination') %></label><input name="destination" value="<%= form.destination||'' %>" class="container-input"></div><div><label class="container-label"><%= t('fields.currentLocation') %></label><input name="current_location" value="<%= form.current_location||'' %>" class="container-input"></div><div><label class="container-label"><%= t('fields.status') %></label><select name="status" class="container-input"><% for(const v of ['draft','loading','in_transit','on_ship','at_sea','in_route','hairatan','mazar','arrived','delivered','closed']){ %><option value="<%= v %>" <%= form.status===v?'selected':'' %>><%= fa(v) %></option><% } %></select></div><div><label class="container-label"><%= t('fields.departureDate') %></label><input name="departure_date" type="date" value="<%= String(form.departure_date||'').slice(0,10) %>" class="container-input"></div><div><label class="container-label"><%= t('fields.arrivalDate') %></label><input name="arrival_date" type="date" value="<%= String(form.arrival_date||'').slice(0,10) %>" class="container-input"></div><%- include('../partials/currency-fields', { prefix: 'containerFreight', amount: form.amount, currency: form.currency, labelClass: 'container-label', inputClass: 'container-input' }) %><div class="md:col-span-2"><label class="container-label"><%= t('fields.notes') %></label><textarea name="notes" rows="2" class="container-input !h-auto py-3"><%= form.notes||'' %></textarea></div></div><div class="mt-5 flex justify-end gap-3"><a href="/containers" class="h-11 inline-flex items-center rounded-2xl bg-slate-100 px-5 text-sm font-black"><%= t('common.cancel') %></a><button class="h-11 rounded-2xl bg-teal-600 px-6 text-sm font-black text-white"><%= t('common.save') %></button></div></form></div><% } %>
<div class="container-card overflow-hidden rounded-[1.8rem]"><%- include('../partials/table-toolbar', { search, buttons: [{ href: '/containers?form=create', label: t('pages.containers.add'), icon: 'plus', variant: 'primary' }] }) %><div class="overflow-x-auto"><table class="min-w-full text-right text-sm"><thead><tr class="border-b bg-slate-50 text-xs text-slate-500"><th class="px-5 py-4"><%= t('common.row') %></th><th class="px-5 py-4"><%= t('fields.container') %></th><th class="px-5 py-4"><%= t('fields.shipRoute') %></th><th class="px-5 py-4"><%= t('fields.status') %></th><th class="px-5 py-4"><%= t('fields.cbm') %></th><th class="px-5 py-4"><%= t('fields.freight') %></th><th class="px-5 py-4"><%= t('fields.items') %></th><th class="px-5 py-4"><%= t('common.actions') %></th></tr></thead><tbody class="divide-y"><% if(!containers.length){ %><tr><td colspan="8" class="py-12 text-center text-slate-500"><%= t('common.noData') %></td></tr><% } %><% containers.forEach((c, i) => { %><tr class="hover:bg-blue-50/50"><td class="px-5 py-4 font-black text-slate-500"><%= rowNo(pagination, i) %></td><td class="px-5 py-4"><a class="font-black text-blue-700" href="/containers?container=<%= c.id %>"><%= c.container_no %></a><div class="text-xs text-slate-500"><%= c.seal_no||'' %></div></td><td class="px-5 py-4"><%= c.ship_name||'-' %><div class="text-xs text-slate-500"><%= c.origin||'-' %> ← <%= c.destination||'-' %></div></td><td class="px-5 py-4"><%= fa(c.status) %><div class="text-xs text-slate-500"><%= c.current_location||'' %></div></td><td class="px-5 py-4"><%= number(c.total_loaded_cbm,4) %></td><td class="px-5 py-4"><%= formatLegacyMoney(c, 'freight_usd', 'freight_currency') %><div class="text-xs text-slate-500">$<%= number(c.freight_per_cbm_usd,4) %><%= t('fields.perCbm') %></div></td><td class="px-5 py-4"><%= c.items_count||0 %></td><td class="px-5 py-4"><div class="flex gap-2"><a href="/containers?edit=<%= c.id %>" class="rounded-xl bg-slate-100 px-3 py-2 text-xs font-black"><%= t('common.edit') %></a><a href="/containers?container=<%= c.id %>" class="rounded-xl bg-blue-50 px-3 py-2 text-xs font-black text-blue-700"><%= t('fields.loadingSection') %></a><form method="POST" action="/containers/<%= c.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button data-confirm="<%= t('fields.confirmDeleteContainer') %>" class="rounded-xl bg-red-50 px-3 py-2 text-xs font-black text-red-600"><%= t('common.delete') %></button></form></div></td></tr><% }) %></tbody></table></div><div class="border-t px-5 py-4"><%- include('../partials/pagination') %></div></div>
<% if(selectedContainer){ %><div class="container-panel rounded-[1.8rem] p-5 md:p-6"><div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between"><div><p class="text-xs font-black text-blue-700"><%= t('forms.loading.title') %></p><h3 class="mt-1 text-xl font-black"><%= selectedContainer.container_no %></h3><p class="mt-1 text-sm text-slate-500"><%= t('fields.volumeShort') %>: <%= number(selectedContainer.total_loaded_cbm,4) %> | <%= t('fields.freightPerCbm') %>: <%= formatMoney(selectedContainer.freight_per_cbm_usd, selectedContainer.freight_currency) %></p></div><a href="/containers" class="rounded-xl bg-slate-100 px-4 py-2 text-sm font-black"><%= t('common.close') %></a></div>
<form method="POST" action="/containers/<%= selectedContainer.id %>/cargo" class="mt-5 rounded-2xl bg-slate-50 p-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-5"><div class="xl:col-span-2"><label class="container-label"><%= t('fields.cargo') %></label><select name="cargo_item_id" id="cargoSelect" class="container-input" required><option value=""><%= t('fields.selectCargo') %></option><% for(const i of cargoItems){ %><option value="<%= i.id %>" data-cartons="<%= i.carton_count||0 %>" data-cbm="<%= i.total_cbm||0 %>" data-weight="<%= i.gross_weight_kg||0 %>"><%= i.cargo_code %> - <%= i.name %> - <%= i.customer_name||'' %></option><% } %></select></div><div><label class="container-label"><%= t('forms.loading.loadCartons') %></label><input id="cargoCartons" name="cartons_loaded" type="number" min="1" class="container-input" required></div><div><label class="container-label"><%= t('forms.loading.loadCbm') %></label><input id="cargoCbm" name="cbm_loaded" type="number" step="0.0001" min="0" class="container-input" required></div><div><label class="container-label"><%= t('forms.loading.loadWeight') %></label><input id="cargoWeight" name="weight_loaded_kg" type="number" step="0.01" min="0" class="container-input"></div><div class="md:col-span-2 xl:col-span-4"><label class="container-label"><%= t('fields.notes') %></label><input name="item_notes" class="container-input"></div><div class="flex items-end"><button class="h-11 w-full rounded-2xl bg-blue-600 text-sm font-black text-white"><%= t('fields.addItem') %></button></div></div></form>
<div class="mt-5 overflow-x-auto rounded-2xl border"><table class="min-w-full text-right text-sm"><thead class="bg-slate-50"><tr><th class="px-4 py-3"><%= t('fields.cargo') %></th><th class="px-4 py-3"><%= t('fields.customer') %></th><th class="px-4 py-3"><%= t('fields.cartons') %></th><th class="px-4 py-3"><%= t('fields.cbm') %></th><th class="px-4 py-3"><%= t('fields.weight') %></th><th class="px-4 py-3"><%= t('fields.freightShare') %></th><th class="px-4 py-3"><%= t('common.actions') %></th></tr></thead><tbody class="divide-y"><% if(!selectedContainer.items?.length){ %><tr><td colspan="7" class="p-8 text-center text-slate-500"><%= t('fields.noCargoInContainer') %></td></tr><% } %><% for(const i of selectedContainer.items||[]){ %><tr><td class="px-4 py-3 font-black"><%= i.cargo_code||'-' %> - <%= i.cargo_name||'-' %></td><td class="px-4 py-3"><%= i.customer_name||'-' %></td><td class="px-4 py-3"><%= i.cartons_loaded||0 %></td><td class="px-4 py-3"><%= number(i.cbm_loaded,4) %></td><td class="px-4 py-3"><%= faWeight(i.weight_loaded_kg) %></td><td class="px-4 py-3 font-black"><%= formatMoney(i.freight_share_usd, selectedContainer.freight_currency) %></td><td class="px-4 py-3"><form method="POST" action="/containers/<%= selectedContainer.id %>/cargo/<%= i.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button data-confirm="<%= t('fields.confirmRemoveCargoFromContainer') %>" class="rounded-xl bg-red-50 px-3 py-2 text-xs font-black text-red-600"><%= t('common.delete') %></button></form></td></tr><% } %></tbody></table></div></div>
<script>document.getElementById('cargoSelect')?.addEventListener('change',function(){const o=this.selectedOptions[0];if(!o)return;document.getElementById('cargoCartons').value=o.dataset.cartons||'';document.getElementById('cargoCbm').value=o.dataset.cbm||'';document.getElementById('cargoWeight').value=o.dataset.weight||'';});</script><% } %>
</div>
