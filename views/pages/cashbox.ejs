<div class="space-y-5" dir="<%= dir %>">
<%- include('../partials/flash') %>
<% const cashTypeFilter = typeof cashType !== 'undefined' ? cashType : ''; %>
<div class="stat-card-grid grid grid-cols-2 gap-2.5 md:grid-cols-3 xl:grid-cols-6"><% for(const c of [{l:t('fields.opening'),v:opening_balance,i:'money',co:'sky'},{l:t('fields.income'),v:income,i:'payment',co:'emerald'},{l:t('fields.expense'),v:expensesTotal,i:'expense',co:'red'},{l:t('fields.withdraw'),v:withdraws,i:'money',co:'amber'},{l:t('fields.adjustments'),v:adjustments,i:'report',co:'violet'},{l:t('fields.balance'),v:balance,i:'money',co:'green'}]){ %><%- include('../partials/glow-card-stat', { title: c.l, value: formatMoney(c.v), iconName: c.i, color: c.co }) %><% } %></div>
<% if(transactionForm){ %><div class="rounded-[1.8rem] border bg-white p-5 shadow-sm"><div class="flex justify-between border-b pb-4"><div><h3 class="font-black"><%= t('forms.cashbox.transaction') %></h3><p class="mt-1 text-xs text-slate-500"><%= t('forms.cashbox.transactionDesc') %></p></div><a href="/cashbox" class="rounded-xl bg-slate-100 px-4 py-2 text-sm font-black"><%= t('common.close') %></a></div><form method="POST" action="/cashbox/transactions" class="mt-5"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4"><div><label class="mb-2 block text-xs font-black"><%= t('fields.number') %></label><input name="transaction_no" value="<%= transactionForm.transaction_no %>" class="h-11 w-full rounded-xl border px-3"></div><div><label class="mb-2 block text-xs font-black"><%= t('fields.type') %></label><select name="type" class="h-11 w-full rounded-xl border px-3"><option value="income"><%= t('fields.income') %></option><option value="expense"><%= t('fields.expense') %></option><option value="withdraw"><%= t('fields.withdraw') %></option><option value="adjustment"><%= t('fields.adjustments') %></option></select></div><div class="md:col-span-2"><label class="mb-2 block text-xs font-black"><%= t('fields.title') %></label><input name="title" class="h-11 w-full rounded-xl border px-3" required></div><%- include('../partials/currency-fields', { prefix: 'cashTx', amount: transactionForm.amount, currency: transactionForm.currency, amountRequired: true, labelClass: 'mb-2 block text-xs font-black', inputClass: 'h-11 w-full rounded-xl border px-3' }) %><div><label class="mb-2 block text-xs font-black"><%= t('fields.date') %></label><input name="transaction_date" type="date" value="<%= transactionForm.transaction_date %>" class="h-11 w-full rounded-xl border px-3"></div><div class="md:col-span-2 xl:col-span-4"><label class="mb-2 block text-xs font-black"><%= t('fields.notes') %></label><textarea name="notes" rows="2" class="w-full rounded-xl border p-3"></textarea></div></div><div class="mt-4 flex justify-end"><button class="h-11 rounded-xl bg-emerald-600 px-6 font-black text-white"><%= t('common.save') %></button></div></form></div><% } %>
<% if(boxForm){ %><div class="rounded-[1.8rem] border bg-white p-5 shadow-sm"><div class="flex justify-between border-b pb-4"><h3 class="font-black"><%= t('forms.cashbox.box') %></h3><a href="/cashbox" class="rounded-xl bg-slate-100 px-4 py-2 text-sm font-black"><%= t('common.close') %></a></div><form method="POST" action="/cashbox/box" class="mt-5"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="grid grid-cols-1 gap-4 md:grid-cols-2"><div><label class="mb-2 block text-xs font-black"><%= t('fields.boxName') %></label><input name="box_name" value="<%= boxForm.box_name||'' %>" class="h-11 w-full rounded-xl border px-3" required></div><div><label class="mb-2 block text-xs font-black"><%= t('fields.mainCurrency') %></label><select name="box_currency" class="h-11 w-full rounded-xl border px-3"><% enabledCurrencies.forEach(v => { %><option value="<%= v %>" <%= boxForm.box_currency===v?'selected':'' %>><%= fa(v) %></option><% }) %></select></div><div><label class="mb-2 block text-xs font-black"><%= t('fields.openingBalanceUsd') %></label><input name="opening_balance" type="number" step="0.01" value="<%= boxForm.opening_balance||0 %>" class="h-11 w-full rounded-xl border px-3"></div><div><label class="mb-2 block text-xs font-black"><%= t('fields.notes') %></label><textarea name="box_notes" rows="2" class="w-full rounded-xl border p-3"><%= boxForm.box_notes||'' %></textarea></div></div><div class="mt-4 flex justify-end"><button class="h-11 rounded-xl bg-emerald-600 px-6 font-black text-white"><%= t('common.save') %></button></div></form></div><% } %>

<div class="flex flex-wrap gap-2">
  <% const cashTabs = [{k:'',l:t('common.all')},{k:'income',l:t('fields.income')},{k:'expense',l:t('fields.expense')},{k:'withdraw',l:t('fields.withdraw')},{k:'adjustment',l:t('fields.adjustments')}]; %>
  <% cashTabs.forEach(tab => { const href = tab.k ? `/cashbox?cash_type=${tab.k}` : '/cashbox'; %>
    <a href="<%= href %>" class="rounded-xl px-4 py-2 text-xs font-black <%= String(cashTypeFilter||'')===tab.k ? 'bg-teal-600 text-white' : 'bg-slate-100 text-slate-700' %>"><%= tab.l %></a>
  <% }) %>
</div>

<div class="overflow-hidden rounded-[1.8rem] border bg-white shadow-sm"><%- include('../partials/table-toolbar', { search, buttons: [{ href: '/cashbox?box=1', label: t('pages.cashbox.configure'), variant: 'dark' }, { href: '/cashbox?transaction=1', label: t('pages.cashbox.addMovement'), icon: 'plus', variant: 'emerald' }] }) %><div class="overflow-x-auto"><table class="min-w-full text-right text-sm"><thead class="bg-slate-50"><tr><th class="px-4 py-3"><%= t('common.row') %></th><th class="px-4 py-3"><%= t('fields.number') %></th><th class="px-4 py-3"><%= t('reportCols.direction') %></th><th class="px-4 py-3"><%= t('fields.type') %></th><th class="px-4 py-3"><%= t('fields.title') %></th><th class="px-4 py-3"><%= t('fields.amount') %></th><th class="px-4 py-3"><%= t('fields.date') %></th><th class="px-4 py-3"><%= t('fields.source') %></th><th class="px-4 py-3"><%= t('common.actions') %></th></tr></thead><tbody class="divide-y"><% if(!transactions.length){ %><tr><td colspan="9" class="p-10 text-center text-slate-500"><%= t('fields.noMovements') %></td></tr><% } %><% transactions.forEach((tx, i) => { const inflow = tx.type==='income' || (tx.type==='adjustment' && Number(tx.amount)>=0); %><tr><td class="px-4 py-3 font-black text-slate-500"><%= rowNo(pagination, i) %></td><td class="px-4 py-3 font-black"><%= tx.transaction_no %></td><td class="px-4 py-3 font-black <%= inflow ? 'text-emerald-700' : 'text-red-700' %>"><%= inflow ? t('expenseVia.inflow') : t('expenseVia.outflow') %></td><td class="px-4 py-3"><%= fa(tx.type) %></td><td class="px-4 py-3"><%= localizeTitle(tx.title) %></td><td class="px-4 py-3 font-black <%= inflow ? 'text-emerald-700' : 'text-red-700' %>"><%= inflow ? '+' : '-' %> <%= formatMoney(tx.amount, tx.currency) %></td><td class="px-4 py-3"><%= formatDate(tx.transaction_date) %></td><td class="px-4 py-3"><%= faSource(tx.source_type||'manual') %></td><td class="px-4 py-3"><% if(tx.source_type!=='expense' && tx.source_type!=='payment'){ %><form method="POST" action="/cashbox/transactions/<%= tx.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button data-confirm="<%= t('fields.confirmDeleteCash') %>" class="rounded-xl bg-red-50 px-3 py-2 text-xs font-black text-red-600"><%= t('common.delete') %></button></form><% } else { %><span class="text-xs text-slate-400"><%= t('fields.auto') %></span><% } %></td></tr><% }) %></tbody></table></div><div class="border-t px-5 py-4"><%- include('../partials/pagination') %></div></div>
</div>
