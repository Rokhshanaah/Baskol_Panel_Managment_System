<%
  const brandLogoPath = typeof logoPath !== 'undefined' ? logoPath : (appSettings?.logoPath || '');
  const brandLogoUrl = brandLogoPath ? '/storage/' + String(brandLogoPath).replace(/^\/+/, '') : '';
%>
<% if (brandLogoUrl) { %>
  <span class="brand-logo brand-logo--photo <%= typeof logoClass !== 'undefined' ? logoClass : '' %>">
    <img src="<%= brandLogoUrl %>" alt="" class="brand-logo__img">
  </span>
<% } else { %>
<span class="brand-logo <%= typeof logoClass !== 'undefined' ? logoClass : '' %>">
  <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <rect x="6" y="24" width="52" height="30" rx="4" stroke="currentColor" stroke-width="3"/>
    <path d="M12 24V16h40v8" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M22 24v30M32 24v30M42 24v30" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
    <path d="M10 10h44" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
    <path d="M32 10v8" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
    <path d="M18 18l6 4M46 18l-6 4" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
    <circle cx="18" cy="58" r="3" fill="currentColor"/>
    <circle cx="46" cy="58" r="3" fill="currentColor"/>
  </svg>
</span>
<% } %>
