<div class="glow-card glow-card--stat glow-card--<%= color %>">
  <div class="glow-card__inner">
    <div class="glow-card__head">
      <span class="glow-card__icon shrink-0"><%- icon(iconName, 'h-4 w-4') %></span>
      <p class="glow-card__title"><%= title %></p>
    </div>
    <p class="glow-card__value dash-value">
      <%= value %><% if (typeof valueSuffix !== 'undefined' && valueSuffix) { %><span class="glow-card__value-suffix"><%= valueSuffix %></span><% } %>
    </p>
  </div>
</div>
